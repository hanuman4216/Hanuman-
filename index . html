<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Whack-A-Mole Game</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            text-align: center;
            background-color: #f0e6d2;
            margin: 0;
            padding: 20px;
        }

        h1 {
            color: #4a3728;
            margin-bottom: 10px;
        }

        .score-board {
            font-size: 24px;
            font-weight: bold;
            color: #8b5a2b;
            margin-bottom: 20px;
        }

        /* The 3x3 Grid Board */
        .game-grid {
            display: grid;
            grid-template-columns: repeat(3, 120px);
            grid-gap: 15px;
            justify-content: center;
            margin: 0 auto;
            max-width: 400px;
        }

        /* Each Dirt Hole */
        .hole {
            width: 120px;
            height: 120px;
            background-color: #654321;
            border-radius: 50%;
            position: relative;
            overflow: hidden;
            border: 4px solid #3d2511;
            box-shadow: inset 0 10px 10px rgba(0,0,0,0.5);
        }

        /* The Mole Graphic */
        .mole {
            width: 80px;
            height: 80px;
            background-color: #a0522d;
            border-radius: 50% 50% 0 0;
            position: absolute;
            bottom: -80px; /* Hidden below the hole initially */
            left: 20px;
            transition: bottom 0.1s ease;
            cursor: pointer;
        }

        /* Eye and nose styling using pseudo-elements */
        .mole::before {
            content: '👀';
            position: absolute;
            top: 15px;
            left: 22px;
            font-size: 18px;
        }

        /* Class added by JS when the mole pops up */
        .mole.up {
            bottom: 0;
        }

        .start-btn {
            background-color: #4caf50;
            color: white;
            padding: 12px 24px;
            font-size: 18px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            margin-top: 25px;
        }

        .start-btn:hover {
            background-color: #45a049;
        }
    </style>
</head>
<body>

    <h1>Whack-A-Mole!</h1>
    <div class="score-board">Score: <span id="score">0</span></div>
    
    <div class="game-grid">
        <div class="hole"><div class="mole"></div></div>
        <div class="hole"><div class="mole"></div></div>
        <div class="hole"><div class="mole"></div></div>
        <div class="hole"><div class="mole"></div></div>
        <div class="hole"><div class="mole"></div></div>
        <div class="hole"><div class="mole"></div></div>
        <div class="hole"><div class="mole"></div></div>
        <div class="hole"><div class="mole"></div></div>
        <div class="hole"><div class="mole"></div></div>
    </div>

    <button class="start-btn" onclick="startGame()">Start Game</button>

    <script>
        const holes = document.querySelectorAll('.hole');
        const moles = document.querySelectorAll('.mole');
        const scoreDisplay = document.getElementById('score');
        
        let lastHole;
        let timeUp = false;
        let score = 0;

        // Generate a random active duration for the mole
        function randomTime(min, max) {
            return Math.round(Math.random() * (max - min) + min);
        }

        // Pick a random hole layout element without repeating the last one
        function randomHole(holes) {
            const idx = Math.floor(Math.random() * holes.length);
            const hole = holes[idx];
            if (hole === lastHole) {
                return randomHole(holes);
            }
            lastHole = hole;
            return hole;
        }

        // Loop execution to make moles continuously pop up
        function peep() {
            const time = randomTime(600, 1200); // speed range in milliseconds
            const hole = randomHole(holes);
            const mole = hole.querySelector('.mole');
            
            mole.classList.add('up');

            setTimeout(() => {
                mole.classList.remove('up');
                if (!timeUp) peep();
            }, time);
        }

        // Initialize and trigger game states
        function startGame() {
            scoreDisplay.textContent = 0;
            score = 0;
            timeUp = false;
            peep();
            
            // End the game session after 15 seconds
            setTimeout(() => {
                timeUp = true;
                alert(`Game Over! Your final score is: ${score}`);
            }, 15000);
        }

        // Add event listeners to catch clicks/whacks on moles
        moles.forEach(mole => {
            mole.addEventListener('click', (e) => {
                // Prevent simulated/cheated clicks
                if(!e.isTrusted) return; 
                
                score++;
                mole.classList.remove('up');
                scoreDisplay.textContent = score;
            });
        });
    </script>

</body>
</html>
